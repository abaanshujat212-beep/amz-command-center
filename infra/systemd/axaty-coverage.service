[Unit]
Description=Create the monthly AXATY raw data coverage report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=axaty
Group=axaty
WorkingDirectory=/opt/axaty/command-center
EnvironmentFile=/etc/axaty/coverage.env
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/axaty/raw-coverage
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=6min
ExecStart=/opt/axaty/command-center/.venv/bin/python infra/scripts/report_raw_monthly_coverage.py --output-dir /var/lib/axaty/raw-coverage
