# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the filled file.
# ---------------------------------------------------------------------------

# --- Amazon SP-API (private app, self-authorized by the Seller Central primary user) ---
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
MARKETPLACE_ID=A1F83G8C2ARO7P

# --- Amazon Ads API (our LWA app, one refresh token per advertiser) ---
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REFRESH_TOKEN=
ADS_PROFILE_ID=
ADS_ENDPOINT=https://advertising-api-eu.amazon.com
ADS_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token

# --- Datastores ---
DATABASE_URL=postgresql://axaty:axaty@localhost:5432/axaty
REDIS_URL=redis://localhost:6379

# --- Encryption (token vault). Generate a 32-byte base64 key, rotate by bumping key_version. ---
KEK_BASE64=
KEK_VERSION=1

# --- Reporting ---
TZ_REPORTING=Europe/London
DEFAULT_CURRENCY=GBP

# --- Safety switches ---
AUTOMATION_ENABLED=false
DRY_RUN=true
MAX_BID_CHANGE_PCT=25
CHANGE_COOLDOWN_DAYS=3

# --- Keepa (Phase 7) ---
KEEPA_API_KEY=
