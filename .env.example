# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the filled file.
# ---------------------------------------------------------------------------

# --- Amazon SP-API (private app, self-authorized by the Seller Central primary user) ---
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
MARKETPLACE_ID=A1F83G8C2ARO7P

# --- Amazon Ads API (our LWA app, one refresh token per advertiser) ---
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REFRESH_TOKEN=
ADS_PROFILE_ID=
ADS_ENDPOINT=https://advertising-api-eu.amazon.com
ADS_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token

# --- Postgres container (read by docker compose) ---
POSTGRES_USER=axaty
POSTGRES_PASSWORD=axaty
POSTGRES_DB=axaty

# --- Datastores ---
# Owner role: runs migrations and dbt. Bypasses nothing, but owns the tables.
DATABASE_URL=postgresql://axaty:axaty@localhost:5432/axaty
# Application role: what the API and dashboard use. RLS applies to it, so a
# missing set_tenant() call returns zero rows instead of another tenant's.
# It also has no privilege on the marts schema, so the dashboard can only read
# marts through the tenant-filtered copilot.* views (0007, 0008).
#
# Also the role that writes the copilot's audit trail and its llm_call rows: the
# copilot is read-only and cannot write either, which is the point.
DATABASE_URL_APP=postgresql://axaty_app:axaty_app@localhost:5432/axaty
# Copilot role (migration 0007): read-only at the server, no access to marts,
# no access to amazon_connection. Every question the AI asks the database goes
# through this connection and nothing else.
#
# The role itself is created by the migration without a password, because a
# migration lives in git forever. Create the login user once, by hand:
#   create user axaty_copilot_app with password '<choose one>';
#   grant axaty_copilot to axaty_copilot_app;
DATABASE_URL_COPILOT=postgresql://axaty_copilot_app:CHANGE_ME@localhost:5432/axaty
REDIS_URL=redis://localhost:6379

# --- Tests ---
# tests/test_engine.py skips entirely when this is unset, so an unset value
# means green CI that tested nothing. `make testdb && make migrate-test`.
TEST_DB_NAME=axaty_test
TEST_DATABASE_URL=postgresql://axaty:axaty@localhost:5432/axaty_test

# --- Dashboard (apps/web) ---
# TEMPORARY, until Better Auth is wired. The app will not guess a tenant: with
# DEV_TENANT_ID unset it errors instead of silently showing "the first one".
# Get the value from `make seed` output.
DEV_TENANT_ID=
# Written into action.approved_by and audit_log.actor_user_id. Unset means the
# approval queue renders read-only, because an approval nobody signed is not an
# approval. Must be a uuid.
DEV_OPERATOR_USER_ID=

# --- Encryption (token vault). Generate a 32-byte base64 key, rotate by bumping key_version. ---
KEK_BASE64=
KEK_VERSION=1

# --- Reporting ---
TZ_REPORTING=Europe/London
DEFAULT_CURRENCY=GBP

# --- Safety switches ---
AUTOMATION_ENABLED=false
DRY_RUN=true
MAX_BID_CHANGE_PCT=25
CHANGE_COOLDOWN_DAYS=3

# --- Keepa (Phase 7) ---
KEEPA_API_KEY=

# --- LLM providers (#35, bring your own key). Only the one you use is needed. ---
# A typo here raises rather than falling back to the default: sending a tenant's
# data to a provider they did not choose is a consent problem, not a typo.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Local escape hatch for clients who will not send sales data to a third party.
# When LLM_PROVIDER=ollama, naming remote fallbacks below is an error, not a
# convenience: it would undo the only decision that client made.
OLLAMA_BASE_URL=http://localhost:11434

# Override the provider's default model. Must be a model the price table knows,
# or LLM_ALLOW_UNPRICED must be set.
LLM_MODEL=

# Tried in order after a 429/5xx on the primary. Never used after a refusal, and
# never after a 401/403 — a rejected key is misconfiguration, and moving the same
# request to a provider that does have a key hides it while spending money.
LLM_FALLBACK_PROVIDERS=

# Hard monthly ceiling in USD, enforced BEFORE a call is dispatched.
#
# USD, not GBP: providers bill in USD and llm_call.cost_usd stores USD. The
# product reports in GBP but the two are never mixed at write time, because
# converting then would bake one day's FX rate into a permanent record.
#
# 0 means model calls are OFF, not unlimited.
LLM_MONTHLY_BUDGET=25

# Allow models with no known price. Off by default: a budget that cannot price a
# call cannot enforce anything, and would report headroom while spending freely.
LLM_ALLOW_UNPRICED=false

# Optional. Sent as HTTP-Referer/X-Title so OpenRouter can attribute traffic.
LLM_APP_URL=http://localhost:3000

# Optional base-URL overrides (self-hosted gateways, proxies, regional endpoints).
OPENROUTER_BASE_URL=
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=
